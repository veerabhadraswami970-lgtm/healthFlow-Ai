# HealthFlow AI — environment variables
# Currently the app runs with NO environment variables required —
# auth is hand-rolled (stdlib hashlib/hmac/secrets), data is in-memory.
# This file documents what you will need once you add real integrations.

# --- JWT signing (only needed if you externalize the secret instead of
# the hardcoded/in-code key currently used in users.py) ---
JWT_SECRET_KEY=replace-with-a-long-random-string

# --- LLM provider (only needed once you wire a real client into the
# 7 agents' llm_client parameter instead of the None/fallback default) ---
GEMINI_API_KEY=

# --- MongoDB (only needed if/when you replace the InMemory*Repository
# classes with real Mongo-backed ones) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=healthflow_ai
